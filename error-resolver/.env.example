# =============================================================
# Error Resolver — environment configuration
#
# SENSITIVE VALUES (passwords, tokens) should NOT be put here.
# Use one of these two approaches instead:
#
#   Option A — AWS Secrets Manager (recommended for AWS deployments)
#     Store secrets once in Secrets Manager, then just set the
#     secret NAME below. The app fetches values at runtime via
#     your IAM role — no password ever touches a file.
#
#   Option B — OS environment variables (good for local dev)
#     Export in your shell profile (~/.bashrc / ~/.zshrc), e.g.:
#       export GITHUB_PAT=ghp_xxxx
#       export ORACLE_PASSWORD=s3cr3t
#     These are never written to a project file.
#
# Non-sensitive values (hostnames, region, model) can go here.
# =============================================================

# ── AWS Secrets Manager secret names ─────────────────────────
# Set these to the names of your secrets in Secrets Manager.
# Leave blank to fall back to OS environment variables.
#
# Secret JSON format expected:
#   error-resolver/github  → {"pat": "ghp_xxxx"}
#   error-resolver/oracle  → {"username": "app_user", "password": "s3cr3t"}
#   error-resolver/tavily  → {"api_key": "tvly-xxxx"}
#
AWS_SECRET_GITHUB=error-resolver/github
AWS_SECRET_ORACLE=error-resolver/oracle
AWS_SECRET_TAVILY=error-resolver/tavily

# ── AWS region (for Secrets Manager + Bedrock if used) ───────
AWS_REGION=us-east-1

# ── GitHub Copilot (GitHub Models API) ───────────────────────
# Token comes from Secrets Manager — no GITHUB_PAT needed here.
COPILOT_ENDPOINT=https://models.inference.ai.azure.com
COPILOT_MODEL=gpt-4o

# ── GitHub MCP Server — which repo to search ─────────────────
# These are not sensitive (public repo names / org names).
GITHUB_REPO_OWNER=your-org-or-username
GITHUB_REPO_NAME=your-repository

# ── Oracle RDS — connection details (not sensitive) ──────────
# Username + password come from Secrets Manager.
ORACLE_HOST=your-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCL
