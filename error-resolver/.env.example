# ---------------------------------------------------------------
# GitHub PAT — used for BOTH GitHub Copilot AI and the MCP server
# Requires: models:read scope (for Copilot) + repo:read (for MCP)
# ---------------------------------------------------------------
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub Copilot (GitHub Models API)
# Endpoint is the GitHub Models inference endpoint — no changes needed
COPILOT_ENDPOINT=https://models.inference.ai.azure.com
# gpt-4o supports screenshot/image analysis; gpt-4o-mini is cheaper for text-only
COPILOT_MODEL=gpt-4o

# Web Search — used to research the error before looking at your code
# Leave TAVILY_API_KEY blank to use DuckDuckGo (free, no key needed)
# Get a free Tavily key at https://tavily.com (better quality for AI agents)
TAVILY_API_KEY=

# GitHub MCP Server — repository to search for code context
GITHUB_REPO_OWNER=your-org-or-username
GITHUB_REPO_NAME=your-repository

# AWS RDS Oracle (optional — leave blank to skip DB context)
ORACLE_HOST=your-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCL
ORACLE_USERNAME=app_user
ORACLE_PASSWORD=your_password
