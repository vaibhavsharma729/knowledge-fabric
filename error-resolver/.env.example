# AWS Bedrock — Claude model for error analysis
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
# Claude 3.5 Sonnet v2 (multimodal — supports image screenshots)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# GitHub MCP Server
# Personal Access Token with repo:read scope
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_OWNER=your-org-or-username
GITHUB_REPO_NAME=your-repository

# AWS RDS Oracle
ORACLE_HOST=your-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCL
ORACLE_USERNAME=app_user
ORACLE_PASSWORD=your_password
